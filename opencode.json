{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "experimental_image_generate", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "execute", "resource": "*", "effect": "ask" },
    { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "allow" },
    { "action": "opencode_read_mcp_resource", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "bot-improvements": {
      "permissions": [
        { "action": "subagent", "resource": "bot-runtime", "effect": "allow" },
        { "action": "subagent", "resource": "bot-actions", "effect": "allow" },
        { "action": "subagent", "resource": "bot-safety", "effect": "allow" },
        { "action": "subagent", "resource": "bot-strategy", "effect": "allow" },
        { "action": "subagent", "resource": "bot-review", "effect": "allow" }
      ]
    },
    "bot-runtime": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "bot-actions": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "bot-safety": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "bot-strategy": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "bot-review": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
